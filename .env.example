# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,budgetwise-backend,budgetwise-backend-xpi5.onrender.com
CSRF_TRUSTED_ORIGINS=https://budgetwise-backend-xpi5.onrender.com,http://localhost:8000
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Database
# Local Docker uses POSTGRES_* variables.
# Render can use DATABASE_URL from Render PostgreSQL instead.
DATABASE_URL=
DB_CONN_MAX_AGE=60
POSTGRES_DB=finance_db
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=False

# Logging
DJANGO_LOG_LEVEL=INFO
DJANGO_SQL_LOG_LEVEL=WARNING
APP_LOG_LEVEL=DEBUG

# Render / Gunicorn
PORT=10000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Monitoring
METRICS_ACCESS_TOKEN=budgetwise-metrics-dev-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=240
REFRESH_TOKEN_LIFETIME_DAYS=7

# Throttling
LOGIN_THROTTLE_RATE=5/min
FORGOT_PASSWORD_IP_THROTTLE_RATE=10/min
FORGOT_PASSWORD_EMAIL_THROTTLE_RATE=3/hour

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=BudgetWise <noreply@budgetwise.local>

# Email confirmation
FRONTEND_EMAIL_VERIFY_URL=http://app.budgetwise.localhost:5173/auth/verify-email
EMAIL_CONFIRMATION_TOKEN_TIMEOUT_SECONDS=86400
EMAIL_CONFIRMATION_TOKEN_SALT=budgetwise.email-confirmation
REGISTRATION_REQUIRE_EMAIL_CONFIRMATION=False

# Password reset
FRONTEND_PASSWORD_RESET_URL=http://app.budgetwise.localhost:5173/auth/reset-password
PASSWORD_RESET_TOKEN_TIMEOUT_SECONDS=3600
PASSWORD_RESET_TOKEN_BYTES=32

# Password reset throttling
FORGOT_PASSWORD_IP_THROTTLE_RATE=10/min
FORGOT_PASSWORD_EMAIL_THROTTLE_RATE=3/hour

# Fiscal receipt provider: proverkacheka.com
PROVERKACHEKA_ENABLED=True
PROVERKACHEKA_API_TOKEN=
PROVERKACHEKA_API_URL=https://proverkacheka.com/api/v1/check/get
PROVERKACHEKA_TIMEOUT_SECONDS=10

# User profile
USER_PROFILE_AVATAR_MAX_SIZE_BYTES=5242880

# Currency rates
CURRENCY_RATES_ENABLED=True
CURRENCY_RATES_CACHE_SECONDS=900
CURRENCY_RATES_FAILURE_CACHE_SECONDS=300
CURRENCY_RATES_TIMEOUT_SECONDS=2.0
CURRENCY_FIAT_RATES_URL=https://www.cbr.ru/scripts/XML_daily.asp
CURRENCY_CRYPTO_RATES_URL=https://api.coingecko.com/api/v3/simple/price

# PWA and push notifications
PWA_PUSH_SUBSCRIPTIONS_ENABLED=True
PWA_PUSH_SEND_ENABLED=False
PWA_PUSH_PROVIDER=web_push
PWA_VAPID_PUBLIC_KEY=
PWA_VAPID_PRIVATE_KEY=
PWA_VAPID_SUBJECT=mailto:your-email@example.com
PWA_MAX_PUSH_SUBSCRIPTIONS_PER_USER=10
PWA_BACKGROUND_SYNC_ENABLED=True
PWA_BACKGROUND_SYNC_RETRY_SECONDS=30
PWA_PUSH_TTL_SECONDS=60

# Render production example
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DEBUG=False
# ALLOWED_HOSTS=your-backend-name.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-backend-name.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
# DATABASE_URL=postgresql://user:password@host:5432/database
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
