# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,budgetwise-backend,budgetwise-backend-xpi5.onrender.com
CSRF_TRUSTED_ORIGINS=https://budgetwise-backend-xpi5.onrender.com,http://localhost:8000
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Database
# Local Docker uses POSTGRES_* variables.
# Render can use DATABASE_URL from Render PostgreSQL instead.
DATABASE_URL=
DB_CONN_MAX_AGE=60
POSTGRES_DB=finance_db
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=False

# Logging
DJANGO_LOG_LEVEL=INFO
DJANGO_SQL_LOG_LEVEL=WARNING
APP_LOG_LEVEL=DEBUG

# Render / Gunicorn
PORT=10000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Monitoring
METRICS_ACCESS_TOKEN=budgetwise-metrics-dev-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Redis / Celery
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_HEALTH_ENABLED=True
REDIS_HEALTH_REQUIRED=False
REDIS_HEALTH_TIMEOUT_SECONDS=1.0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_LOG_LEVEL=info
CELERY_TIMEZONE=Europe/Moscow
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=True
CELERY_TASK_REJECT_ON_WORKER_LOST=True
CELERY_HEALTH_ENABLED=True
CELERY_HEALTH_REQUIRED=False
CELERY_HEALTH_TIMEOUT_SECONDS=1.0

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=240
REFRESH_TOKEN_LIFETIME_DAYS=7

# Throttling
LOGIN_THROTTLE_RATE=5/min
FORGOT_PASSWORD_IP_THROTTLE_RATE=10/min
FORGOT_PASSWORD_EMAIL_THROTTLE_RATE=3/hour

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=BudgetWise <noreply@budgetwise.local>

# Email verification
EMAIL_VERIFICATION_ENABLED=True
EMAIL_VERIFICATION_SEND_ASYNC=True
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_PATH=/verify-email
# Backward-compatible full URL override. Usually keep empty and use FRONTEND_BASE_URL + EMAIL_VERIFICATION_PATH.
# FRONTEND_EMAIL_VERIFY_URL=http://localhost:5173/verify-email
EMAIL_VERIFICATION_TOKEN_TIMEOUT_SECONDS=86400
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_CONFIRMATION_TOKEN_SALT=budgetwise.email-confirmation
# Deprecated alias for older deployments. Use EMAIL_VERIFICATION_ENABLED instead.
REGISTRATION_REQUIRE_EMAIL_CONFIRMATION=True

# Phone verification
PHONE_VERIFICATION_ENABLED=True
PHONE_VERIFICATION_SEND_ASYNC=True
PHONE_VERIFICATION_PROVIDER=console
PHONE_DEFAULT_REGION=RU
PHONE_VERIFICATION_CODE_TTL_SECONDS=900
PHONE_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PHONE_VERIFICATION_MAX_ATTEMPTS=5
PHONE_VERIFICATION_CODE_SALT=budgetwise.phone-verification
# SMS Aero provider settings. Used when PHONE_VERIFICATION_PROVIDER=smsaero.
# Keep PHONE_VERIFICATION_PROVIDER=console for local development without real SMS sending.
SMSAERO_EMAIL=
SMSAERO_API_KEY=
SMSAERO_SIGN=SMS Aero
SMSAERO_BASE_URL=https://gate.smsaero.ru/v2
SMSAERO_TIMEOUT_SECONDS=10
SMSAERO_TEST_MODE=False
PHONE_VERIFICATION_SMS_TEXT_TEMPLATE=Код подтверждения BudgetWise: {code}. Никому не сообщайте этот код.

# Password reset
FRONTEND_PASSWORD_RESET_URL=http://app.budgetwise.localhost:5173/auth/reset-password
PASSWORD_RESET_TOKEN_TIMEOUT_SECONDS=3600
PASSWORD_RESET_TOKEN_BYTES=32

# Password reset throttling
FORGOT_PASSWORD_IP_THROTTLE_RATE=10/min
FORGOT_PASSWORD_EMAIL_THROTTLE_RATE=3/hour

# Fiscal receipt provider: proverkacheka.com
PROVERKACHEKA_ENABLED=True
PROVERKACHEKA_API_TOKEN=
PROVERKACHEKA_API_URL=https://proverkacheka.com/api/v1/check/get
PROVERKACHEKA_TIMEOUT_SECONDS=10

# User profile
USER_PROFILE_AVATAR_MAX_SIZE_BYTES=5242880
AVATAR_STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AVATAR_FOLDER=budgetwise/avatars

# Currency rates
CURRENCY_RATES_ENABLED=True
CURRENCY_RATES_CACHE_SECONDS=900
CURRENCY_RATES_FAILURE_CACHE_SECONDS=300
CURRENCY_RATES_TIMEOUT_SECONDS=2.0
CURRENCY_FIAT_RATES_URL=https://www.cbr.ru/scripts/XML_daily.asp
CURRENCY_CRYPTO_RATES_URL=https://api.coingecko.com/api/v3/simple/price

# PWA and push notifications
PWA_PUSH_SUBSCRIPTIONS_ENABLED=True
PWA_PUSH_SEND_ENABLED=False
PWA_PUSH_PROVIDER=web_push
PWA_VAPID_PUBLIC_KEY=
PWA_VAPID_PRIVATE_KEY=
PWA_VAPID_SUBJECT=mailto:your-email@example.com
PWA_MAX_PUSH_SUBSCRIPTIONS_PER_USER=10
PWA_BACKGROUND_SYNC_ENABLED=True
PWA_BACKGROUND_SYNC_RETRY_SECONDS=30
PWA_PUSH_TTL_SECONDS=60

# Render production example
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DEBUG=False
# ALLOWED_HOSTS=your-backend-name.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-backend-name.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
# DATABASE_URL=postgresql://user:password@host:5432/database
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
