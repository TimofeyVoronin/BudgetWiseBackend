      "targets": [
        {
          "expr": "sum(rate(api_errors_total[5m])) by (status_code, code)",
          "legendFormat": "{{status_code}} {{code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
