                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token",
                "refresh",
                ""
              ]
            },
            "description": "Planned endpoint for refreshing JWT access token."
          },
          "response": []
        }
      ],
