    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Get token - planned",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.access) {",
                  "        pm.environment.set('access_token', json.access);",
                  "    }",
                  "    if (json.refresh) {",
                  "        pm.environment.set('refresh_token', json.refresh);",
                  "    }",
                  "}",
                  "",
                  "pm.test('Status is 200 after auth endpoint implementation', function () {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token",
                ""
              ]
            },
            "description": "Planned endpoint for getting JWT tokens. Will be enabled after auth endpoints are implemented."
          },
          "response": []
        },
        {
          "name": "Refresh token - planned",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.access) {",
                  "        pm.environment.set('access_token', json.access);",
                  "    }",
                  "    if (json.refresh) {",
                  "        pm.environment.set('refresh_token', json.refresh);",
                  "    }",
                  "}",
                  "",
                  "pm.test('Status is 200 after auth endpoint implementation', function () {",
                  "    pm.expect([200, 401, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/refresh/",
